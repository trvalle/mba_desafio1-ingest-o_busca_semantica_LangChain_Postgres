# Variáveis de ambiente — Análise de Exames de Sangue
# Copie este arquivo para .env e preencha os valores

# Chave de API do Google (Gemini)
GOOGLE_API_KEY=sua_chave_aqui

# Configurações do LLM (opcionais — valores padrão definidos em config.py)
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Configurações de retry para controle de cota da API
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=30
